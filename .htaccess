# --- Enable Rewrite ---
RewriteEngine On

# Auto-detect base: works at root (prod /) and subdir (dev /Rielcode/)
# Sets %{ENV:BASE} to the directory this .htaccess lives in.
RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
RewriteRule ^(.*)$ - [E=BASE:%1]

# --- Prevent directory listing ---
Options -Indexes

# --- Protect sensitive config files ---
<Files "config.php">
  Require all denied
</Files>

# --- Cache control ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/* "access plus 1 year"
</IfModule>


# --- Proxy alias for chatbot (MUST be first) ---
RewriteRule ^proxy$ proxy.php [L,QSA]

# --- Admin aliases (.php direct access pass-through) ---
RewriteRule ^admin_login\.php$ - [L]
RewriteRule ^admin_logout\.php$ - [L]
RewriteRule ^admin\.php$ - [L]
RewriteRule ^admin_edit\.php$ - [L]
RewriteRule ^admin_invoice_edit\.php$ - [L]
RewriteRule ^admin_audit\.php$ - [L]

# --- Admin clean-URL aliases ---
RewriteRule ^admin_login$ admin_login.php [L,QSA]
RewriteRule ^admin_logout$ admin_logout.php [L,QSA]
RewriteRule ^admin$ admin.php [L,QSA]
RewriteRule ^admin_edit$ admin_edit.php [L,QSA]
RewriteRule ^admin_invoice_edit$ admin_invoice_edit.php [L,QSA]
RewriteRule ^admin_audit$ admin_audit.php [L,QSA]

# --- Redirect /index.php → / (only if file actually exists) ---
RewriteCond %{THE_REQUEST} \s%{ENV:BASE}index\.php[\s?] [NC]
RewriteRule ^index\.php$ %{ENV:BASE} [R=301,L]

# --- Strip .php extension for clean URLs ---
RewriteCond %{THE_REQUEST} \s%{ENV:BASE}([^.\s]+)\.php[\s?] [NC]
RewriteCond %1 !^(proxy|admin|admin_edit|admin_login|admin_logout|admin_invoice_edit|admin_audit)$
RewriteRule ^ %{ENV:BASE}%1 [R=301,L]

# --- Internally map clean URL → .php ---
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/.]+)$ $1.php [L]
